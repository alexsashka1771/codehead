{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codehead:clinic_demo:v1:http",
  "title": "Clinic Demo v1 HTTP contract",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "non_blank_name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "timestamp_input": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"const": "ok"}}
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "specialty"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "name": {"$ref": "#/$defs/non_blank_name"},
        "specialty": {"$ref": "#/$defs/non_blank_name"}
      }
    },
    "doctor_create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "specialty"],
      "properties": {
        "name": {"$ref": "#/$defs/non_blank_name"},
        "specialty": {"$ref": "#/$defs/non_blank_name"}
      }
    },
    "doctor_patch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {"$ref": "#/$defs/non_blank_name"},
        "specialty": {"$ref": "#/$defs/non_blank_name"}
      }
    },
    "doctor_list": {"type": "array", "items": {"$ref": "#/$defs/doctor"}},
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "full_name"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "full_name": {"$ref": "#/$defs/non_blank_name"}
      }
    },
    "patient_create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name"],
      "properties": {"full_name": {"$ref": "#/$defs/non_blank_name"}}
    },
    "patient_patch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {"full_name": {"$ref": "#/$defs/non_blank_name"}}
    },
    "patient_list": {"type": "array", "items": {"$ref": "#/$defs/patient"}},
    "appointment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "doctor_id", "patient_id", "starts_at", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "doctor_id": {"$ref": "#/$defs/uuid"},
        "patient_id": {"$ref": "#/$defs/uuid"},
        "starts_at": {"$ref": "#/$defs/timestamp_utc"},
        "status": {"enum": ["scheduled", "cancelled"]}
      }
    },
    "appointment_create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doctor_id", "patient_id", "starts_at"],
      "properties": {
        "doctor_id": {"$ref": "#/$defs/uuid"},
        "patient_id": {"$ref": "#/$defs/uuid"},
        "starts_at": {"$ref": "#/$defs/timestamp_input"}
      }
    },
    "appointment_patch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "doctor_id": {"$ref": "#/$defs/uuid"},
        "patient_id": {"$ref": "#/$defs/uuid"},
        "starts_at": {"$ref": "#/$defs/timestamp_input"}
      }
    },
    "appointment_list": {"type": "array", "items": {"$ref": "#/$defs/appointment"}},
    "cancel": {"type": "object", "additionalProperties": false, "maxProperties": 0},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S"}
      }
    }
  }
}
