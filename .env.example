# Optional external PostgreSQL connection. Leave empty for the local development cluster.
CODEHEAD_DATABASE_URL=
# Only required when starting the API directly. tools/dev.py creates a random token in memory.
CODEHEAD_COMMAND_TOKEN=
# Live configuration is reserved for the worker stage. Supply secrets through the environment.
CODEHEAD_LLM_PROVIDER=
CODEHEAD_LLM_MODEL=
CODEHEAD_LLM_API_KEY=
CODEHEAD_LLM_MAX_TOKENS=
CODEHEAD_LLM_MAX_COST_USD=
