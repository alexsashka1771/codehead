{
  "name": "codehead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/dev.ps1",
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/setup.ps1",
    "db": "node tools/postgres.mjs",
    "contracts": "node tools/contracts.mjs",
    "contracts:check": "node tools/contracts.mjs --check",
    "check": "node tools/check.mjs",
    "build": "npm run build --workspace @codehead/frontend",
    "test:backend": "node tools/test-backend.mjs",
    "test:clinic": "node tools/test-clinic.mjs",
    "test:e2e": "node tools/test-e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "json-schema-to-typescript": "16.0.0",
    "pg": "8.23.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "18.6.0-beta.19"
  }
}
